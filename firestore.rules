rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada jogador autenticado só tem permissão para ler e gravar seu próprio perfil
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Bloqueia qualquer outro acesso não autorizado por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
