rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // FUNÇÕES AUXILIARES DE AUTENTICAÇÃO E VALIDAÇÃO
    // =========================================================================

    // Verifica estritamente se o usuário está autenticado via Google (provedor google.com)
    function isGoogleUser() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Validações de texto (tamanho e tipo)
    function isValidPlayerName(name) {
      return name is string && name.size() >= 1 && name.size() <= 35;
    }

    function isValidAvatar(avatar) {
      return avatar is string && avatar.size() >= 1 && avatar.size() <= 60;
    }

    function isValidDifficulty(diff) {
      return diff in ['EASY', 'MEDIUM', 'HARD', 'EXPERT'];
    }

    // Validações numéricas e limites plausíveis de pontuação
    function isValidScore(score) {
      return score is number && score >= 0 && score <= 2000000;
    }

    function isValidTotalScore(totalScore) {
      return totalScore is number && totalScore >= 0 && totalScore <= 500000000;
    }

    function isValidAccuracy(acc) {
      return acc is number && acc >= 0 && acc <= 100;
    }

    function isValidMaxCombo(combo) {
      return combo is number && combo >= 0 && combo <= 10000;
    }

    function isValidStars(stars) {
      return stars is number && stars >= 1 && stars <= 5;
    }

    function isValidSeason(season) {
      return season == 's1';
    }

    // Ausência absoluta de campos confidenciais ou dados privados
    function hasNoPrivateData() {
      return !('email' in request.resource.data) &&
        !('token' in request.resource.data) &&
        !('password' in request.resource.data) &&
        !('secret' in request.resource.data) &&
        !('admin' in request.resource.data) &&
        !('role' in request.resource.data);
    }

    // Verifica se o usuário autenticado possui credenciais válidas de administrador
    // Privilégios concedidos exclusivamente por Custom Claims criptográficos verificados do Firebase
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'SUPER_ADMIN'
      );
    }

    // =========================================================================
    // VALIDAÇÕES ESPECÍFICAS DE PERFIL DE USUÁRIO E ECONOMIA (V14.6.1)
    // =========================================================================

    // Chaves permitidas e obrigatórias no documento de perfil
    function isValidUserProfileKeys() {
      return request.resource.data.keys().hasOnly([
        'uid', 'name', 'avatar',
        'rockCoins', 'totalCoinsEarned', 'totalCoinsSpent',
        'unlockedSongIds', 'achievements', 'records', 'settings',
        'transactions', 'season', 'migrationVersion', 'lastPlayedAt', 'updatedAt'
      ]) && request.resource.data.keys().hasAll([
        'uid', 'name', 'avatar',
        'rockCoins', 'totalCoinsEarned', 'totalCoinsSpent',
        'unlockedSongIds', 'season', 'updatedAt'
      ]);
    }

    // Verifica se a atualização NÃO está alterando nenhum campo econômico ou de inventário
    function isNotModifyingEconomy() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'rockCoins', 'totalCoinsEarned', 'totalCoinsSpent', 'unlockedSongIds', 'transactions'
      ]);
    }

    // Extrai com segurança campos numéricos de recurso existente (compatibilidade legada)
    function getResourceCoins() {
      return ('rockCoins' in resource.data && resource.data.rockCoins is number)
        ? resource.data.rockCoins : 0;
    }

    function getResourceEarned() {
      return ('totalCoinsEarned' in resource.data && resource.data.totalCoinsEarned is number)
        ? resource.data.totalCoinsEarned : getResourceCoins();
    }

    function getResourceSpent() {
      return ('totalCoinsSpent' in resource.data && resource.data.totalCoinsSpent is number)
        ? resource.data.totalCoinsSpent : 0;
    }

    function getResourceUnlockedSize() {
      return ('unlockedSongIds' in resource.data && resource.data.unlockedSongIds is list)
        ? resource.data.unlockedSongIds.size() : 3;
    }

    // Validação de tipos e limites dos campos de perfil
    function isValidUserProfileData() {
      return request.resource.data.uid is string &&
        request.resource.data.uid == request.auth.uid &&
        isValidPlayerName(request.resource.data.name) &&
        isValidAvatar(request.resource.data.avatar) &&
        isValidSeason(request.resource.data.season) &&
        request.resource.data.updatedAt is number &&
        request.resource.data.rockCoins is number &&
        request.resource.data.rockCoins >= 0 &&
        request.resource.data.totalCoinsEarned is number &&
        request.resource.data.totalCoinsEarned >= 0 &&
        request.resource.data.totalCoinsSpent is number &&
        request.resource.data.totalCoinsSpent >= 0 &&
        // Teto absoluto de moedas para prevenir overflow e números astronômicos
        request.resource.data.totalCoinsEarned <= 500000 &&
        // Invariante de solvência: saldo atual não pode superar o total ganho
        request.resource.data.rockCoins <= request.resource.data.totalCoinsEarned &&
        // Músicas desbloqueadas: lista com no mínimo as 3 gratuitas padrão e no máximo catálogo total
        request.resource.data.unlockedSongIds is list &&
        request.resource.data.unlockedSongIds.size() >= 3 &&
        request.resource.data.unlockedSongIds.size() <= 250 &&
        request.resource.data.unlockedSongIds.hasAll(['mam-1406', 'cap-sua-maneira', 'pit-chip-novo']) &&
        // Tipos opcionais válidos quando presentes
        (!('achievements' in request.resource.data) || request.resource.data.achievements is map) &&
        (!('records' in request.resource.data) || request.resource.data.records is map) &&
        (!('settings' in request.resource.data) || request.resource.data.settings is map) &&
        (!('transactions' in request.resource.data) || request.resource.data.transactions is list) &&
        (!('migrationVersion' in request.resource.data) || request.resource.data.migrationVersion is number) &&
        (!('lastPlayedAt' in request.resource.data) || request.resource.data.lastPlayedAt is number) &&
        hasNoPrivateData();
    }

    // =========================================================================
    // COLEÇÃO: users/{userId} — PERFIS PRIVADOS DE JOGADORES (V14.6.1 BLINDADA)
    // =========================================================================
    match /users/{userId} {
      // Leitura permitida para o próprio usuário autenticado ou administrador
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Bloqueio rigoroso de exclusão de perfis pelos clientes
      allow delete: if false;

      // Criação de perfil inicial (novo jogador autenticado ou migração inicial de convidado)
      allow create: if request.auth != null && request.auth.uid == userId &&
        isValidUserProfileKeys() &&
        isValidUserProfileData() &&
        // Limite plausível para conta recém-criada (impede bot inicial com milhões de moedas)
        request.resource.data.totalCoinsEarned <= 10000 &&
        request.resource.data.unlockedSongIds.size() <= 50;

      // Atualização de perfil: impede manipulação de moedas, liberação fraudulenta de músicas e regressão de dados
      allow update: if request.auth != null && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.season == resource.data.season &&
          isValidUserProfileKeys() &&
          isValidUserProfileData() &&
          (
            // CAMADA 1: Atualização normal de perfil (nome, avatar, settings, records, achievements)
            // O cliente é terminantemente impedido de modificar saldos ou inventário diretamente
            isNotModifyingEconomy() ||
            // CAMADA 2: Transação atômica estritamente calibrada (máximo 5 moedas por partida concluída)
            (
              // Ganho estrito de partida: no máximo 5 moedas por conclusão de música
              (request.resource.data.totalCoinsEarned - getResourceEarned()) <= 5 &&
              request.resource.data.totalCoinsEarned >= getResourceEarned() &&
              request.resource.data.totalCoinsSpent >= getResourceSpent() &&
              // Se o saldo aumentou, o delta de rockCoins é rigorosamente idêntico ao delta ganho
              (
                request.resource.data.rockCoins <= getResourceCoins() ||
                (request.resource.data.rockCoins - getResourceCoins()) == (request.resource.data.totalCoinsEarned - getResourceEarned())
              ) &&
              // Desbloqueio atômico de compra: no máximo 1 música por operação, exigindo gasto comprovado >= 5 moedas
              (
                request.resource.data.unlockedSongIds.size() == getResourceUnlockedSize() ||
                (
                  (request.resource.data.unlockedSongIds.size() - getResourceUnlockedSize()) == 1 &&
                  request.resource.data.unlockedSongIds.hasAll(
                    ('unlockedSongIds' in resource.data && resource.data.unlockedSongIds is list)
                      ? resource.data.unlockedSongIds : ['mam-1406', 'cap-sua-maneira', 'pit-chip-novo']
                  ) &&
                  (request.resource.data.totalCoinsSpent - getResourceSpent()) >= 5 &&
                  (getResourceCoins() - request.resource.data.rockCoins) >= 5
                )
              )
            )
          )
        )
      );

      // =========================================================================
      // SUBCOLEÇÃO: users/{userId}/economy_ledger/{ledgerId} — LIVRO-RAZÃO ATÔMICO
      // =========================================================================
      match /economy_ledger/{ledgerId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow update, delete: if false;
        allow create: if request.auth != null && (
          isAdmin() ||
          (
            request.auth.uid == userId &&
            request.resource.data.keys().hasOnly([
              'idempotencyKey', 'type', 'songId', 'difficulty', 'earnedCoins',
              'cost', 'score', 'accuracy', 'hits', 'misses', 'matchTimestamp',
              'processedAt', 'purchasedAt', 'purchaseTxId'
            ]) &&
            request.resource.data.type in ['EARN', 'SPEND'] &&
            (
              request.resource.data.type != 'EARN' ||
              (
                request.resource.data.earnedCoins is number &&
                request.resource.data.earnedCoins >= 0 &&
                request.resource.data.earnedCoins <= 5 &&
                ledgerId == request.resource.data.idempotencyKey &&
                request.resource.data.matchTimestamp is number
              )
            ) &&
            (
              request.resource.data.type != 'SPEND' ||
              (
                request.resource.data.cost is number &&
                request.resource.data.cost >= 0 &&
                request.resource.data.cost <= 100
              )
            )
          )
        );
      }
    }

    // =========================================================================
    // COLEÇÃO: rankings_summary/{userId} — RESUMO DO RANKING GERAL (TEMPORADA 1)
    // =========================================================================
    match /rankings_summary/{userId} {
      // Leitura permitida exclusivamente para contas Google
      allow read: if isGoogleUser();

      // Bloqueio rigoroso de exclusão de dados pelos clientes
      allow delete: if false;

      // Criação de resumo de pontuação
      allow create: if isGoogleUser() &&
        request.auth.uid == userId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid', 'playerName', 'avatar', 'totalScore', 'songsCount', 'updatedAt', 'season']) &&
        request.resource.data.keys().hasAll(['uid', 'playerName', 'avatar', 'totalScore', 'songsCount', 'updatedAt', 'season']) &&
        isValidPlayerName(request.resource.data.playerName) &&
        isValidAvatar(request.resource.data.avatar) &&
        isValidTotalScore(request.resource.data.totalScore) &&
        request.resource.data.songsCount is number &&
        request.resource.data.songsCount >= 0 &&
        request.resource.data.songsCount <= 1000 &&
        request.resource.data.updatedAt is number &&
        isValidSeason(request.resource.data.season) &&
        hasNoPrivateData();

      // Atualização de resumo: impede regressão de totalScore e protege identidade
      allow update: if isGoogleUser() &&
        request.auth.uid == userId &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.season == resource.data.season &&
        request.resource.data.totalScore >= resource.data.totalScore &&
        request.resource.data.keys().hasOnly(['uid', 'playerName', 'avatar', 'totalScore', 'songsCount', 'updatedAt', 'season']) &&
        isValidPlayerName(request.resource.data.playerName) &&
        isValidAvatar(request.resource.data.avatar) &&
        isValidTotalScore(request.resource.data.totalScore) &&
        request.resource.data.songsCount is number &&
        request.resource.data.songsCount >= 0 &&
        request.resource.data.songsCount <= 1000 &&
        request.resource.data.updatedAt is number &&
        isValidSeason(request.resource.data.season) &&
        hasNoPrivateData();
    }

    // =========================================================================
    // COLEÇÃO: rankings_song/{recordId} — RECORDES POR MÚSICA E DIFICULDADE (S1)
    // =========================================================================
    match /rankings_song/{recordId} {
      // Leitura permitida exclusivamente para contas Google
      allow read: if isGoogleUser();

      // Bloqueio rigoroso de exclusão de recordes pelos clientes
      allow delete: if false;

      // Criação de recorde individual
      allow create: if isGoogleUser() &&
        request.auth.uid == request.resource.data.uid &&
        recordId == (request.resource.data.songId + '_' + request.resource.data.difficulty + '_' + request.auth.uid) &&
        request.resource.data.keys().hasOnly(['uid', 'songId', 'songTitle', 'artist', 'difficulty', 'score', 'accuracy', 'maxCombo', 'stars', 'playerName', 'avatar', 'updatedAt', 'season']) &&
        request.resource.data.keys().hasAll(['uid', 'songId', 'songTitle', 'artist', 'difficulty', 'score', 'accuracy', 'maxCombo', 'stars', 'playerName', 'avatar', 'updatedAt', 'season']) &&
        request.resource.data.songId is string &&
        request.resource.data.songId.size() >= 1 &&
        request.resource.data.songId.size() <= 64 &&
        request.resource.data.songTitle is string &&
        request.resource.data.songTitle.size() >= 1 &&
        request.resource.data.songTitle.size() <= 80 &&
        request.resource.data.artist is string &&
        request.resource.data.artist.size() >= 1 &&
        request.resource.data.artist.size() <= 80 &&
        isValidDifficulty(request.resource.data.difficulty) &&
        isValidScore(request.resource.data.score) &&
        isValidAccuracy(request.resource.data.accuracy) &&
        isValidMaxCombo(request.resource.data.maxCombo) &&
        isValidStars(request.resource.data.stars) &&
        isValidPlayerName(request.resource.data.playerName) &&
        isValidAvatar(request.resource.data.avatar) &&
        request.resource.data.updatedAt is number &&
        isValidSeason(request.resource.data.season) &&
        hasNoPrivateData();

      // Atualização de recorde: impede downgrade de pontuação e garante imutabilidade de chaves
      allow update: if isGoogleUser() &&
        request.auth.uid == request.resource.data.uid &&
        recordId == (request.resource.data.songId + '_' + request.resource.data.difficulty + '_' + request.auth.uid) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.songId == resource.data.songId &&
        request.resource.data.difficulty == resource.data.difficulty &&
        request.resource.data.season == resource.data.season &&
        request.resource.data.score >= resource.data.score &&
        request.resource.data.keys().hasOnly(['uid', 'songId', 'songTitle', 'artist', 'difficulty', 'score', 'accuracy', 'maxCombo', 'stars', 'playerName', 'avatar', 'updatedAt', 'season']) &&
        request.resource.data.songTitle is string &&
        request.resource.data.songTitle.size() >= 1 &&
        request.resource.data.songTitle.size() <= 80 &&
        request.resource.data.artist is string &&
        request.resource.data.artist.size() >= 1 &&
        request.resource.data.artist.size() <= 80 &&
        isValidDifficulty(request.resource.data.difficulty) &&
        isValidScore(request.resource.data.score) &&
        isValidAccuracy(request.resource.data.accuracy) &&
        isValidMaxCombo(request.resource.data.maxCombo) &&
        isValidStars(request.resource.data.stars) &&
        isValidPlayerName(request.resource.data.playerName) &&
        isValidAvatar(request.resource.data.avatar) &&
        request.resource.data.updatedAt is number &&
        isValidSeason(request.resource.data.season) &&
        hasNoPrivateData();
    }

    // =========================================================================
    // COLEÇÃO: admin_users/{userId} — PRIVILÉGIOS DE ADMINISTRAÇÃO DO ESTÚDIO
    // =========================================================================
    match /admin_users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Apenas administradores confirmados por token podem gravar privilégios administrativos
      // Um usuário comum NUNCA pode se promover ou alterar este documento
      allow write: if isAdmin();
    }

    // =========================================================================
    // COLEÇÃO: published_songs/{songId} — CATÁLOGO OFICIAL DE MÚSICAS PUBLICADAS
    // =========================================================================
    match /published_songs/{songId} {
      // Visitantes e jogadores comuns podem consultar as músicas publicadas
      allow read: if true;
      // Apenas administradores autenticados podem publicar, editar ou excluir músicas
      allow write: if isAdmin();
    }

    // =========================================================================
    // COLEÇÃO: sync_profiles/{songId} — REGISTROS DE SINCRONIZAÇÃO MUSICAL
    // =========================================================================
    match /sync_profiles/{songId} {
      // Leitura pública para sincronização da esteira no jogo
      allow read: if true;
      // Apenas administradores autenticados podem alterar perfis de sincronização
      allow write: if isAdmin();
    }

    // =========================================================================
    // COLEÇÃO: admin_history/{historyId} — HISTÓRICO DE AUDITORIA ADMINISTRATIVA
    // =========================================================================
    match /admin_history/{historyId} {
      // Histórico confidencial de curadoria exclusivo para administradores
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // COLEÇÃO: publication_settings/{settingId} — CONFIGURAÇÕES DE PUBLICAÇÃO
    // =========================================================================
    match /publication_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // BLOQUEIO GERAL PADRÃO
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
